# Copy to .env (or set in your host's dashboard). All optional except where noted.
NODE_ENV=production
PORT=3000
# Public address of the site, used for canonical links, Open Graph, sitemap and JSON-LD.
SITE_URL=https://goforgedigital.com
# Hosted database (required on Vercel). Leave empty to use a local SQLite file in DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local mode only: folder for the SQLite file and fallback session secret.
DATA_DIR=/var/data/goforge
# 32+ random characters. Required on Vercel. Elsewhere, if unset, one is generated into DATA_DIR/secret.key.
SESSION_SECRET=
# Optional: Vercel Blob token for admin image uploads (set automatically when a Blob store is connected).
BLOB_READ_WRITE_TOKEN=
# Admin login email (only used when the first admin account is created).
ADMIN_EMAIL=goforgedigital@gmail.com
# Optional: set the first admin password yourself instead of generating one.
ADMIN_INITIAL_PASSWORD=
# Proxy hops to trust for client IPs (rate limiting, secure cookies). 1 on Render/Railway/behind Nginx.
TRUST_PROXY=1
# Optional analytics. Leave both empty and nothing is loaded.
# GA4 measurement ID, for example G-XXXXXXXX. Loads only when this matches that shape.
GA_MEASUREMENT_ID=
# Plausible site domain, for example goforgedigital.com. Script host defaults to https://plausible.io.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=https://plausible.io
# Optional: Vercel Web Analytics (cookie-free). Set to 1 after enabling Web Analytics in the Vercel dashboard. Only loads on Vercel.
ENABLE_VERCEL_ANALYTICS=
# Optional: email alerts for every new form lead, sent with Resend (https://resend.com). Off when RESEND_API_KEY is empty.
RESEND_API_KEY=
# Where alerts go (comma separated). Default info@goforgedigital.com.
LEAD_ALERT_TO=info@goforgedigital.com
# Sender. Must be on a domain verified in Resend, for example "Goforge Digital Website <alerts@goforgedigital.com>".
LEAD_ALERT_FROM=Goforge Digital Website <alerts@goforgedigital.com>
