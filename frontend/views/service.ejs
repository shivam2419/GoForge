<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-item><a class="crumb" href="/services">Services</a></p>
    <h1 class="h1 hero-title-sm"><span class="line"><span><%= service.name %></span></span></h1>
    <p class="lede" data-hero-item><%= s[service.key] %></p>
    <div class="hero-actions" data-hero-item>
      <a class="btn btn-primary btn-lg" href="/contact?service=<%= encodeURIComponent(service.name) %>" data-dialog="dlg-contact" data-fallback-form="contact" data-prefill-name="service" data-prefill-value="<%= service.name %>">Talk about this <%- include('partials/icon', { name: 'upright' }) %></a>
      <a class="btn btn-ghost btn-lg" href="/contact?service=<%= encodeURIComponent(OFFERS.check.name) %>" data-dialog="dlg-contact" data-fallback-form="contact" data-prefill-name="service" data-prefill-value="<%= OFFERS.check.name %>">Free website check</a>
    </div>
  </div>
</section>
<section class="section section-tight">
  <div class="wrap detail-grid">
    <article class="detail-block" data-reveal>
      <p class="mini-h">This can include</p>
      <ul class="check-list">
        <% service.includes.forEach(item => { %><li><%- include('partials/icon', { name: 'check' }) %><span><%= item %></span></li><% }) %>
      </ul>
      <p class="row-start"><%= service.start %></p>
    </article>
    <article class="detail-block" data-reveal>
      <p class="mini-h">What we ask on a first call</p>
      <ol class="plain-ol">
        <% service.questions.forEach(item => { %><li><%= item %></li><% }) %>
      </ol>
    </article>
    <article class="detail-block" data-reveal>
      <p class="mini-h">What you get at handover</p>
      <ul class="check-list">
        <% service.handover.forEach(item => { %><li><%- include('partials/icon', { name: 'check' }) %><span><%= item %></span></li><% }) %>
      </ul>
    </article>
  </div>
</section>
<section class="section section-alt">
  <div class="wrap prose">
    <h2 class="h3">How the price is set</h2>
    <p>After the call you get one written scope and one clear price, shaped to your budget. For ads, the media budget stays in your own ad account and is separate from the studio fee.</p>
    <p><a class="text-link" href="/faq#clients">More answers for clients <%- include('partials/icon', { name: 'arrow' }) %></a></p>
  </div>
</section>
<%- include('partials/footer') %>
