<%- include('partials/head') %>
<%- include('partials/header') %>
<% const p = program; %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-item><a class="crumb" href="/internship">Training + internship</a></p>
    <h1 class="h1 hero-title-sm"><span class="line"><span><%= p.name %></span></span> <span class="line"><span><em>Training with Internship</em></span></span></h1>
    <p class="lede" data-hero-item><%= p.summary %></p>
    <div class="hero-actions" data-hero-item>
      <a class="btn btn-primary btn-lg" href="#apply">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
      <a class="btn btn-ghost btn-lg" href="/counselling?program=<%= encodeURIComponent(p.name) %>" data-dialog="dlg-counsel" data-fallback-form="counsel" data-prefill-name="program" data-prefill-value="<%= p.name %>">Book a free counselling call</a>
    </div>
    <div class="prog-links" data-hero-item>
      <a class="btn btn-ghost btn-sm" href="/internship/overview.pdf" target="_blank" rel="noopener">Syllabus &amp; overview (PDF) <%- include('partials/icon', { name: 'upright' }) %></a>
      <a class="btn btn-ghost btn-sm" href="/refund">Refund policy <%- include('partials/icon', { name: 'arrow' }) %></a>
      <a class="btn btn-ghost btn-sm" href="/contact?service=<%= encodeURIComponent(OFFERS.demo.name) %>" data-dialog="dlg-contact" data-fallback-form="contact" data-prefill-name="service" data-prefill-value="<%= OFFERS.demo.name %>">Free demo class</a>
    </div>
    <%- include('partials/batch-strip', { anchor: '#batch' }) %>
    <dl class="facts" data-reveal-group>
      <% CAREER_TRACKS.forEach(t => { %><div data-reveal><dt><%= t.name %> &middot; <%= inr(offer.priceOf(t)) %></dt><dd><%= t.trainingMonths %> month<%= t.trainingMonths > 1 ? 's' : '' %> training + <%= t.internshipMonths %> months internship</dd></div><% }) %>
      <div data-reveal><dt>Mode</dt><dd><%= p.modeText %>, every class recorded</dd></div>
      <div data-reveal><dt>Included</dt><dd>Projects, internship, certificate + letter</dd></div>
    </dl>
  </div>
</section>

<% const tcProg = toolChips(p.toolsList); %>
<%- include('partials/page-nav', { label: p.name, items: [['#curriculum', 'Curriculum'], ...(tcProg.chips.length ? [['#tools', 'Tools']] : []), ['#fit', 'Is it for you'], ['#kit', 'What you get'], ['#batch', 'Batch'], ['#fees', 'Fees'], ['#compare', 'Compare'], ['#apply', 'Apply']] }) %>

<%- include('partials/trust', { stats, credentials }) %>

<% if (p.overview) { %>
<section class="section section-tight"><div class="wrap prose"><p class="prose-lead" data-reveal><%= p.overview %></p></div></section>
<% } %>

<% if (p.curriculumList.length) { %>
<section class="section section-tight" id="curriculum" aria-labelledby="cur-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Curriculum</p>
      <h2 id="cur-h" class="h2" data-reveal>Module by <em>module.</em></h2>
    </div>
    <ol class="curriculum" data-zoom data-reveal>
      <% p.curriculumList.forEach((m, i) => { %>
      <li>
        <details<% if (i === 0) { %> open<% } %>>
          <summary><% if (m.label) { %><span class="cur-label"><%= m.label %></span><% } %><span class="cur-title"><%= m.title %></span></summary>
          <% if (m.topics.length) { %><ul class="check-list"><% m.topics.forEach(t => { %><li><%- include('partials/icon', { name: 'check' }) %><span><%= t %></span></li><% }) %></ul><% } %>
          <% if (m.task) { %><p class="cur-task"><strong><%= m.taskLabel %>:</strong> <%= m.task %></p><% } %>
        </details>
      </li>
      <% }) %>
    </ol>
  </div>
</section>
<% } %>

<%- include('partials/tool-grid', { tools: p.toolsList }) %>

<section class="section section-alt">
  <div class="wrap detail-grid">
    <% if (p.coversList.length) { %>
    <article class="detail-block" data-reveal>
      <p class="mini-h">What you learn</p>
      <ul class="check-list"><% p.coversList.forEach(item => { %><li><%- include('partials/icon', { name: 'check' }) %><span><%= item %></span></li><% }) %></ul>
    </article>
    <% } %>
    <% if (p.toolsList.length && !tcProg.chips.length) { %>
    <article class="detail-block" data-reveal>
      <p class="mini-h">Tools</p>
      <ul class="check-list"><% p.toolsList.forEach(item => { %><li><%- include('partials/icon', { name: 'check' }) %><span><%= item %></span></li><% }) %></ul>
      <p class="row-start">Tools follow the project. Not every batch uses every tool.</p>
    </article>
    <% } %>
    <% if (p.project) { %>
    <article class="detail-block" data-reveal>
      <p class="mini-h">A typical project</p>
      <p><%= p.project %></p>
      <p class="row-start">During the internship you work on a piece of studio work of this shape, or a practice project if no client task fits. The letter describes what you did.</p>
    </article>
    <% } %>
    <article class="detail-block" data-reveal>
      <p class="mini-h">Who it suits</p>
      <% if (p.suits) { %><p><%= p.suits %></p><% } %>
      <% if (p.eligibility) { %><p class="row-start"><strong>Who can apply:</strong> <%= p.eligibility %></p><% } %>
    </article>
  </div>
</section>

<%- include('partials/fit-check') %>

<%- include('partials/kit', { alt: true }) %>

<%- include('partials/batch-panel', { rows: upcomingRows(p.batchesList) }) %>

<section class="section section-alt" id="fees" aria-labelledby="price-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Programme length and price</p>
      <h2 id="price-h" class="h2" data-reveal><%= p.name %>: <em>3 or 6 months.</em></h2>
      <p class="section-intro" data-reveal>Festive launch price, all-inclusive: live classes, study material, projects, the internship, the training certificate and the internship letter. Paid once, with no instalments.</p>
    </div>
    <ul class="track-grid track-grid-2" data-reveal-group>
      <% CAREER_TRACKS.forEach(t => { const tw = Math.round(100 * t.trainingMonths / t.months); %>
      <li data-reveal>
        <article class="track-card">
          <div class="track-top">
            <p class="track-weeks"><strong><%= t.months %></strong> months</p>
            <p class="track-price"><span>Festive launch price</span><strong><%= inr(offer.priceOf(t)) %></strong><small>All-inclusive &middot; no instalments</small></p>
          </div>
          <h3 class="track-name"><%= p.name %>: <%= t.name %></h3>
          <svg class="track-split" viewBox="0 0 100 10" preserveAspectRatio="none" role="img" aria-label="<%= t.trainingMonths %> month<%= t.trainingMonths > 1 ? 's' : '' %> of training, then <%= t.internshipMonths %> months of internship"><rect class="seg-train" x="0" y="0" width="<%= tw - 1 %>" height="10"/><rect class="seg-intern" x="<%= tw + 1 %>" y="0" width="<%= 99 - tw %>" height="10"/></svg>
          <p class="track-legend"><span class="lg lg-train"><%= t.trainingMonths %> month<%= t.trainingMonths > 1 ? 's' : '' %> training</span><span class="lg lg-intern"><%= t.internshipMonths %> months internship</span></p>
          <p class="track-who"><%= t.who %></p>
          <a class="btn btn-primary track-cta" href="/counselling?program=<%= encodeURIComponent(p.name) %>&amp;track=<%= t.slug %>" data-dialog="dlg-counsel" data-fallback-form="counsel" data-prefill-name="track" data-prefill-value="<%= careerTrackLabel(t) %>">Book a free call <%- include('partials/icon', { name: 'arrow' }) %></a>
        </article>
      </li>
      <% }) %>
    </ul>
    <%- include('partials/refund-note') %>
  </div>
</section>

<%- include('partials/compare') %>

<section class="section" aria-labelledby="path-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 id="path-h" class="h2" data-reveal>From training <em>to internship.</em></h2>
    </div>
    <%- include('partials/path') %>
  </div>
</section>

<%- include('partials/people', { instructors, testimonials: [] }) %>

<%- include('partials/final-cta', { inPageApply: true, program: p.name }) %>

<section class="section" id="apply" aria-labelledby="apply-h">
  <div class="wrap split split-form">
    <div>
      <p class="eyebrow" data-reveal>Apply</p>
      <h2 id="apply-h" class="h2" data-reveal>Apply for <em><%= p.name %></em></h2>
      <p class="section-intro" data-reveal>Every certificate and internship letter has an ID you can <a href="/verify">verify online</a>. Share the <a href="/internship/overview.pdf">programme overview</a> with your college, and read the <a href="/faq#students">student FAQ</a> for details.</p>
    </div>
    <div class="form-card" data-reveal>
      <%- include('partials/apply-form', { px: 'p' }) %>
    </div>
  </div>
</section>
<%- include('partials/sticky-cta', { track: p.name }) %>
<%- include('partials/footer') %>
