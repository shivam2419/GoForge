<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-item>About</p>
    <h1 class="h1 hero-title-sm"><span class="line"><span>Software, systems</span></span> <span class="line"><span><em>and the people who build them.</em></span></span></h1>
    <p class="lede" data-hero-item>Goforge Digital is an MSME-registered company in Faridabad. We build software, CRM, ERP and marketing for businesses, and train students on the same kind of work through paid training and internships.</p>
  </div>
</section>
<section class="section section-tight">
  <div class="wrap">
    <dl class="kpi-row">
      <div data-reveal><dt>150+</dt><dd>Student projects completed</dd></div>
      <div data-reveal><dt>100+</dt><dd>Students trained</dd></div>
      <div data-reveal><dt>10+</dt><dd>Instructors and mentors</dd></div>
      <div data-reveal><dt>MSME</dt><dd>Registered with the Government of India</dd></div>
    </dl>
    <div class="section-head">
      <p class="eyebrow" data-reveal>Who we are</p>
      <h2 class="h2" data-reveal>Four things worth <em>knowing first.</em></h2>
    </div>
    <ul class="who-grid" data-reveal-group>
      <li class="who-card" data-reveal>
        <span class="who-icon orb-a"><%- include('partials/icon', { name: 'spark' }) %></span>
        <h3>The studio</h3>
        <p>Custom software, CRM, ERP, automation and marketing, from our office in Faridabad. Students train on the same kind of work we deliver for clients.</p>
      </li>
      <li class="who-card" data-reveal>
        <span class="who-icon orb-b"><%- include('partials/icon', { name: 'tag' }) %></span>
        <h3>For a business</h3>
        <p>You speak to the people doing the work, led by Rohit Sharma. One written scope and one price, then the build. Nothing starts before that is agreed.</p>
        <a href="/services">See services <%- include('partials/icon', { name: 'arrow' }) %></a>
      </li>
      <li class="who-card" data-reveal>
        <span class="who-icon orb-c"><%- include('partials/icon', { name: 'user' }) %></span>
        <h3>For a student</h3>
        <p>Paid live training with study material, assignments and projects, taught by our instructor team, then an internship offer, with a certificate accepted by colleges and recognised by industry.</p>
        <a href="/internship">See the programme <%- include('partials/icon', { name: 'arrow' }) %></a>
      </li>
      <li class="who-card" data-reveal>
        <span class="who-icon orb-d"><%- include('partials/icon', { name: 'check' }) %></span>
        <h3>What is different</h3>
        <p>Real projects, real mentors and certificates earned through real work. Every number on this site comes with a clear definition.</p>
      </li>
    </ul>
  </div>
</section>
<section class="section section-tight">
  <div class="wrap about-grid">
    <figure class="founder-card" data-reveal>
      <%- include('partials/corners') %>
      <%- include('partials/mark', { cls: 'founder-mark', decorative: true, uid: 'about', sizes: '240px', lazy: true }) %>
      <figcaption>
        <span class="founder-name">Rohit Sharma</span>
        <span class="founder-role">Founder &amp; Director</span>
        <a class="founder-link" href="<%= BRAND.linkedin %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'linkedin' }) %> LinkedIn</a>
      </figcaption>
    </figure>
    <div class="prose">
      <p class="prose-lead" data-reveal>Goforge Digital is led by Rohit Sharma, Founder &amp; Director, with a team of developers, marketers and 10+ instructors. We build custom software, CRM and ERP systems, AI automation, and digital marketing.</p>
      <p data-reveal>When you work with us, you speak with the people doing the work. We agree a small scope and a clear price before anything is built, show progress as it happens, and hand over something your team can run, with a short note on how.</p>
      <p data-reveal>We work with small businesses. If you are not sure whether your problem is a software problem, a systems problem or a marketing problem, that is a good first call.</p>
      <h2 class="h3" data-reveal>What we hold ourselves to</h2>
      <ul class="check-list" data-reveal>
        <li><%- include('partials/icon', { name: 'check' }) %><span>Plain language, in writing</span></li>
        <li><%- include('partials/icon', { name: 'check' }) %><span>A price agreed before the build starts</span></li>
        <li><%- include('partials/icon', { name: 'check' }) %><span>Progress you can see at every step</span></li>
        <li><%- include('partials/icon', { name: 'check' }) %><span>A handover your team can actually use</span></li>
      </ul>
      <h2 class="h3" data-reveal>Where we are</h2>
      <address class="about-address" data-reveal><%= BRAND.address.line1 %>, <%= BRAND.address.line2 %>, <%= BRAND.address.region %></address>
      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Talk about a project <%- include('partials/icon', { name: 'upright' }) %></a>
        <% if (s.linkedin_company) { %><a class="btn btn-ghost li-btn" href="<%= s.linkedin_company %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'linkedin' }) %> Follow Goforge Digital on LinkedIn</a><% } %>
        <a class="btn btn-ghost" href="/services">See services</a>
      </div>
    </div>
  </div>
</section>
<section class="section section-alt benefits-sec" aria-labelledby="benefit-h">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>Why Goforge Digital</p>
      <h2 id="benefit-h" class="h2" data-reveal>Everything you need <em>to grow.</em></h2>
    </div>
    <div class="benefits">
      <svg class="benefits-line" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 70 C 150 10 250 10 400 60 S 650 120 800 60 S 1050 10 1200 60"/></svg>
      <ul class="benefit-row" data-reveal-group>
        <li data-reveal><span class="bcircle bc-gold"><%- include('partials/icon', { name: 'book' }) %></span><h3>High-quality resources</h3><p>Structured notes, real-world projects and clear roadmaps for every programme.</p></li>
        <li data-reveal><span class="bcircle bc-navy"><%- include('partials/icon', { name: 'cap' }) %></span><h3>Expert instructors</h3><p>Live classes and reviews from working professionals who mentor you hands-on.</p></li>
        <li data-reveal><span class="bcircle bc-teal"><%- include('partials/icon', { name: 'shield' }) %></span><h3>Verified certificates</h3><p>A training certificate and internship letter with an ID anyone can verify.</p></li>
      </ul>
    </div>
  </div>
</section>
<section class="section journey-sec" aria-labelledby="journey-h">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>Your path with us</p>
      <h2 id="journey-h" class="h2" data-reveal>The internship <em>journey.</em></h2>
      <p class="section-intro" data-reveal>Six clear steps, from your first message to a verified certificate.</p>
    </div>
    <div class="journey" data-reveal>
      <div class="journey-road" aria-hidden="true">
        <svg viewBox="0 0 1200 300" focusable="false"><path class="road-base" d="M0 150 C 50 150 50 95 100 95 C 200 95 200 205 300 205 C 400 205 400 95 500 95 C 600 95 600 205 700 205 C 800 205 800 95 900 95 C 1000 95 1000 205 1100 205 C 1150 205 1150 150 1200 150"/><path class="road-draw" pathLength="1" d="M0 150 C 50 150 50 95 100 95 C 200 95 200 205 300 205 C 400 205 400 95 500 95 C 600 95 600 205 700 205 C 800 205 800 95 900 95 C 1000 95 1000 205 1100 205 C 1150 205 1150 150 1200 150"/><path class="road-line" d="M0 150 C 50 150 50 95 100 95 C 200 95 200 205 300 205 C 400 205 400 95 500 95 C 600 95 600 205 700 205 C 800 205 800 95 900 95 C 1000 95 1000 205 1100 205 C 1150 205 1150 150 1200 150"/></svg>
        <span class="jpin jpin-1"><span>1</span></span><span class="jpin jpin-2"><span>2</span></span><span class="jpin jpin-3"><span>3</span></span><span class="jpin jpin-4"><span>4</span></span><span class="jpin jpin-5"><span>5</span></span><span class="jpin jpin-6"><span>6</span></span>
      </div>
      <ol class="journey-steps">
      <li class="jstep jstep-1"><span class="jnum">1</span><h3>Fill the contact form</h3><p>Tell us who you are and what you would like to learn.</p></li>
      <li class="jstep jstep-2"><span class="jnum">2</span><h3>Submit the application</h3><p>Choose your programme and send the short application form.</p></li>
      <li class="jstep jstep-3"><span class="jnum">3</span><h3>Interview call scheduled</h3><p>Our team calls you to understand your goals and background.</p></li>
      <li class="jstep jstep-4"><span class="jnum">4</span><h3>Discussion & onboarding</h3><p>We confirm your programme and batch, and share your study material.</p></li>
      <li class="jstep jstep-5"><span class="jnum">5</span><h3>Training + internship</h3><p>6 weeks of live training, then a 12-week internship on real projects.</p></li>
      <li class="jstep jstep-6"><span class="jnum">6</span><h3>Certificate & experience letter</h3><p>Receive a verified training certificate and internship letter.</p></li>
      </ol>
    </div>
    <p class="section-cta center" data-reveal><a class="btn btn-primary" href="/internship#apply">Start your application <%- include('partials/icon', { name: 'arrow' }) %></a></p>
  </div>
</section>
<% const certs = (credentials || []).map(c => ({ ...c, img: c.image_url || (/msme|udyam/i.test(c.title + ' ' + (c.issuer || '')) ? '/img/certificates/udyam-certificate-sm.jpg' : ''), full: c.image_url || (/msme|udyam/i.test(c.title + ' ' + (c.issuer || '')) ? '/img/certificates/udyam-certificate.jpg' : '') })).filter(c => c.img); %>
<% if (certs.length) { %>
<section class="section achieve-sec" aria-labelledby="ach-h">
  <div class="wrap<%= certs.length === 1 ? ' achieve-split' : '' %>">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Recognitions</p>
      <h2 id="ach-h" class="h2" data-reveal>Our <em>achievements.</em></h2>
      <p class="section-intro" data-reveal>Goforge Digital is a Government of India registered enterprise. Our registration is public and can be checked on the official Udyam portal.</p>
      <% if (certs.length === 1) { const c = certs[0]; %>
      <ul class="ach-facts" data-reveal-group>
        <li data-reveal><span>Registration</span><strong><%= c.title %></strong></li>
        <% if (c.number) { %><li data-reveal><span>Udyam number</span><strong><%= c.number %></strong></li><% } %>
        <li data-reveal><span>Issued by</span><strong><%= c.issuer || 'Ministry of MSME, Government of India' %></strong></li>
      </ul>
      <p class="ach-actions" data-reveal><a class="btn btn-primary" href="<%= c.full %>" data-dialog="dlg-cert-0">View certificate <%- include('partials/icon', { name: 'eye' }) %></a><% if (c.link_url) { %> <a class="btn btn-ghost" href="<%= c.link_url %>" target="_blank" rel="noopener">Verify on Udyam portal <%- include('partials/icon', { name: 'upright' }) %></a><% } %></p>
      <% } %>
    </div>
    <ul class="cert-grid" data-reveal-group>
      <% certs.forEach((c, i) => { %>
      <li data-reveal>
        <a class="cert-card" href="<%= c.full %>" data-dialog="dlg-cert-<%= i %>">
          <span class="cert-img"><img src="<%= c.img %>" alt="<%= c.title %> certificate of Goforge Digital" loading="lazy" width="919" height="652"><span class="cert-zoom"><%- include('partials/icon', { name: 'eye' }) %> View</span></span>
          <span class="cert-cap"><strong><%= c.title %></strong><span><%= c.issuer || '' %></span></span>
        </a>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<% certs.forEach((c, i) => { %>
<%- include('partials/dialog-open', { id: 'dlg-cert-' + i, wide: true }) %>
    <h2 class="modal-title" id="dlg-cert-<%= i %>-title"><%= c.title %></h2>
    <img class="cert-full" src="<%= c.full %>" alt="<%= c.title %> certificate of Goforge Digital, full view" loading="lazy">
    <p class="modal-note">Personal address and contact details are hidden for privacy.<% if (c.link_url) { %> <a href="<%= c.link_url %>" target="_blank" rel="noopener">Verify on the official portal</a>.<% } %></p>
<%- include('partials/dialog-close') %>
<% }) %>
<% } %>
<section class="section section-alt" aria-labelledby="why-about">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Why work with us</p>
      <h2 id="why-about" class="h2" data-reveal>The reasons we will <em>actually keep.</em></h2>
    </div>
    <ul class="values" data-reveal-group>
      <% WHY_SMALL.forEach(item => { %>
      <li data-reveal><h3><%= item.title %></h3><p><%= item.text %></p></li>
      <% }) %>
    </ul>
  </div>
</section>
<%- include('partials/footer') %>
