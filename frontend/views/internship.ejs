<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-item>Training + internship</p>
    <h1 class="h1 hero-title-sm"><span class="line"><span>Industry Training + Internship</span></span> <span class="line"><span><em>for College Students &amp; Graduates</em></span></span></h1>
    <p class="lede" data-hero-item>Choose a 3-Month or 6-Month Programme: live online training with mentors, then supervised work on real projects with Goforge Digital, an MSME-registered software company. For BTech, BCA, MCA and similar students and recent graduates.</p>
    <p class="lede hero-trust-line" data-hero-item>Every certificate has an ID you can <a href="/verify">verify online</a>.</p>
    <div class="hero-actions" data-hero-item>
      <a class="btn btn-cta btn-lg" href="#apply" data-dialog="dlg-apply" data-fallback-form="apply">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
      <a class="btn btn-ghost btn-lg" href="/counselling" data-dialog="dlg-counsel" data-fallback-form="counsel">Book a free counselling call</a>
      <a class="btn btn-ghost btn-lg" href="#tracks">Compare programmes</a>
    </div>
    <%- include('partials/batch-strip', { anchor: '#batch' }) %>
    <dl class="facts" data-reveal-group>
      <div data-reveal><dt>Length</dt><dd>3 or 6 months</dd></div>
      <div data-reveal><dt>Programme fee</dt><dd><%= inr(CAREER_TRACKS[0].price) %> / <%= inr(CAREER_TRACKS[1].price) %>, all-inclusive</dd></div>
      <div data-reveal><dt>Format</dt><dd>Live online training, then a supervised internship</dd></div>
      <div data-reveal><dt>Who can apply</dt><dd>BTech, BCA, MCA and similar</dd></div>
    </dl>
  </div>
</section>

<%- include('partials/trust', { stats: [], credentials }) %>
<%- include('partials/batch-panel', { alt: true }) %>
<%- include('partials/track-story') %>
<% const tools = TECH_STACK; %>
<% if (tools.length) { %>
<div class="ticker ticker-light" aria-label="Tools and technologies taught">
  <div class="ticker-track">
    <% for (let r = 0; r < 2; r++) { %><div class="ticker-group"<% if (r) { %> aria-hidden="true"<% } %>><% tools.forEach(t => { %><span><%= t %></span><i aria-hidden="true">&#10022;</i><% }) %></div><% } %>
  </div>
</div>
<% } %>

<section class="section" id="kit" aria-labelledby="kit-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>What is included</p>
        <h2 id="kit-h" class="h2" data-reveal><%= s.kit_heading || "Everything you get in one fee." %></h2>
      </div>
      <p class="section-intro" data-reveal><%= s.kit_intro %></p>
    </div>
    <ul class="kit-list" data-reveal-group data-zoom>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'browser' }) %></span><div><h3>Live classes + recordings</h3><p>Taught live online by working practitioners, with recordings shared if you miss a session.</p></div></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'tag' }) %></span><div><h3>Study material</h3><p>Notes, slides and practice files for every module, yours to keep.</p></div></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'check' }) %></span><div><h3>Reviewed assignments</h3><p>Practical tasks after each module checked by an instructor so you build real skill.</p></div></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'code' }) %></span><div><h3>Real projects</h3><p>Mini projects during training plus a capstone you can open and explain in interviews.</p></div></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'key' }) %></span><div><h3>Training certificate</h3><p>Issued when you complete the training, carrying a certificate ID anyone can <a href="/verify">verify</a>.</p></div></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'user' }) %></span><div><h3>Internship offer &amp; letter</h3><p>Supervised internship work plus a signed letter naming your role, dates, hours and work.</p></div></li>
    </ul>
  </div>
</section>

<section class="section section-alt" id="programs" aria-labelledby="programs-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>Programmes</p>
        <h2 id="programs-h" class="h2" data-reveal>Choose a <em>programme</em></h2>
      </div>
      <p class="section-intro" data-reveal>Pick the role you want to learn, in the 3-Month or the 6-Month Programme. Open a programme for its curriculum, tools and batches. Interested in something close to these? Apply with "Similar role" and name it in your note.</p>
    </div>
    <ul class="role-grid" data-reveal-group data-zoom>
      <% PROGRAMS.forEach((t, i) => { %>
      <li data-reveal id="program-<%= t.slug %>">
        <div class="role-card">
          <span class="service-top"><span class="service-icon"><%- include('partials/icon', { name: t.icon }) %></span><span class="service-num"><%= String(i + 1).padStart(2, '0') %></span></span>
          <h3 class="service-name"><a class="role-link" href="/internship/programs/<%= t.slug %>"><%= t.name %></a></h3>
          <p class="service-blurb"><%= t.summary %></p>
          <ul class="program-meta">
            <li>3 or 6 months</li><li>From <%= inr(offer.fromPrice(CAREER_TRACKS)) %></li>
          </ul>
          <a class="btn btn-cta btn-apply" href="/internship/programs/<%= t.slug %>" aria-label="Apply now: <%= t.name %>">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </li>
      <% }) %>
      <li data-reveal>
        <div class="role-card role-card-similar">
          <span class="service-top"><span class="service-icon"><%- include('partials/icon', { name: 'spark' }) %></span><span class="service-num">+</span></span>
          <h3 class="service-name">And similar roles</h3>
          <p class="service-blurb">Interested in a related field? Apply with "Similar role" and tell us which one in your note.</p>
          <a class="btn btn-cta btn-apply" href="/internship?track=<%= encodeURIComponent(SIMILAR_ROLE) %>#apply" data-dialog="dlg-apply" data-fallback-form="apply" data-prefill-name="track" data-prefill-value="<%= SIMILAR_ROLE %>">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </li>
    </ul>
  </div>
</section>

<%- include('partials/compare') %>
<%- include('partials/free-start') %>
<%- include('partials/google-reviews', { kind: 'student', alt: true, showBadge: false }) %>
<%- include('partials/people', { instructors, testimonials }) %>

<% const msme = (locals.credentials || []).find(c => /msme/i.test(c.title)); const docs = locals.sampleDocs || { certificate: '/img/samples/sample-certificate.webp', letter: '/img/samples/sample-internship-letter.webp' }; %>
<section class="section section-alt section-tight trust-why" id="proof" aria-labelledby="why-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>Proof &amp; verification</p>
        <h2 id="why-h" class="h2" data-reveal><%= s.proof_heading || "Credentials & certificates you can check." %></h2>
      </div>
      <p class="section-intro" data-reveal><%= s.proof_intro %> (<a href="/verify">goforgedigital.com/verify</a>)</p>
    </div>
    <ul class="why-grid" data-reveal-group>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'check' }) %></span><h3>MSME registered</h3><p>Udyam <%= msme && msme.number ? msme.number : 'registered' %>. <a href="<%= (msme && msme.link_url) || 'https://udyamregistration.gov.in/Udyam_Verify.aspx' %>" target="_blank" rel="noopener">Verify on Udyam</a></p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'key' }) %></span><h3>Verifiable certificates</h3><p>Every certificate and letter has an ID you can <a href="/verify">verify online</a>.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'user' }) %></span><h3>Signed by our founder</h3><p>Issued and signed by <%= BRAND.founder %>, <%= BRAND.founderRole %>, with phone &amp; email for college checks.<% if (BRAND.linkedin) { %> <a href="<%= BRAND.linkedin %>" target="_blank" rel="noopener">LinkedIn</a><% } %></p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'globe' }) %></span><h3>An office you can visit</h3><p><%= BRAND.address.line1 %>, Sector 81, Faridabad. <a href="/contact">Call before you visit</a>.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'tag' }) %></span><h3>A written refund policy</h3><p>Clear terms before you enrol. <a href="/refund">Read the refund policy</a>.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'browser' }) %></span><h3>Free demo before you enrol</h3><p>Attend a free live class first, then decide. <a href="/contact?service=<%= encodeURIComponent(OFFERS.demo.name) %>" data-dialog="dlg-contact" data-fallback-form="contact" data-prefill-name="service" data-prefill-value="<%= OFFERS.demo.name %>">Book a demo class</a></p></li>
    </ul>
    <div class="samples-grid proof-samples" data-reveal-group>
      <figure class="sample-doc" data-reveal><a href="<%= docs.certificate %>" target="_blank" rel="noopener"><img src="<%= docs.certificate %>" alt="Sample Goforge Digital training certificate with certificate ID GF-SAMPLE-0001" loading="lazy" width="1600" height="1131"></a><figcaption>Training certificate (sample)</figcaption></figure>
      <figure class="sample-doc" data-reveal><a href="<%= docs.letter %>" target="_blank" rel="noopener"><img src="<%= docs.letter %>" alt="Sample Goforge Digital internship offer letter with reference GF-SAMPLE-0001" loading="lazy" width="1131" height="1600"></a><figcaption>Internship offer letter (sample)</figcaption></figure>
    </div>
  </div>
</section>

<%- include('partials/student-work', { projects }) %>
<%- include('partials/gallery', { gallery }) %>
<%- include('partials/fit-check') %>

<section class="section" aria-labelledby="faq-h">
  <div class="wrap faq-wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Questions students ask</p>
      <h2 id="faq-h" class="h2" data-reveal>Questions, <em>answered.</em></h2>
    </div>
    <%- include('partials/faq-accordion', { items: FAQ.find(group => group.id === 'students').items.filter(i => i.top).slice(0, 6), name: 'faq-internship', openFirst: true }) %>
    <p class="faq-more"><a class="text-link" href="/faq#students">All student &amp; parent questions <%- include('partials/icon', { name: 'arrow' }) %></a></p>
  </div>
</section>

<%- include('partials/final-cta', { inPageApply: true }) %>

<section class="section section-alt" id="apply" aria-labelledby="apply-h">
  <div class="wrap split split-form">
    <div>
      <p class="eyebrow" data-reveal>Apply</p>
      <h2 id="apply-h" class="h2" data-reveal>Send your <em>application</em></h2>
      <p class="section-intro" data-reveal>We read every application and reply by phone or email. Projects and the internship are included in the price.<% if (offer.registrationOpen) { %> <%= BATCH_SUMMARY %>, with only <%= SEAT_CAP %> seats per schedule.<% } %> Read the <a href="/faq#students">student FAQ</a> and the <a href="/internship/overview.pdf">programme overview (PDF)</a> before you apply.</p>
    </div>
    <div class="form-card" data-reveal>
      <%- include('partials/apply-form') %>
    </div>
  </div>
</section>
<%- include('partials/sticky-cta') %>
<%- include('partials/footer') %>
