<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-item>Training + internship</p>
    <h1 class="h1 hero-title-sm"><span class="line"><span>Industry Training + Internship</span></span> <span class="line"><span><em>for College Students &amp; Graduates</em></span></span></h1>
    <p class="lede" data-hero-item>Choose a 3-Month or 6-Month Programme: live online training with mentors, then supervised work on real projects with Goforge Digital, an MSME-registered software company. For BTech, BCA, MCA and similar students and recent graduates.</p>
    <p class="lede hero-trust-line" data-hero-item>Every certificate has an ID you can <a href="/verify">verify online</a>.</p>
    <div class="hero-actions" data-hero-item>
      <a class="btn btn-primary btn-lg" href="#apply" data-dialog="dlg-apply" data-fallback-form="apply">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
      <a class="btn btn-ghost btn-lg" href="/counselling" data-dialog="dlg-counsel" data-fallback-form="counsel">Book a free counselling call</a>
      <a class="btn btn-ghost btn-lg" href="#tracks">Compare programmes</a>
    </div>
    <%- include('partials/batch-strip', { anchor: '#batch' }) %>
    <dl class="facts" data-reveal-group>
      <div data-reveal><dt>Length</dt><dd>3 or 6 months</dd></div>
      <div data-reveal><dt>Festive launch price</dt><dd><%= inr(CAREER_TRACKS[0].price) %> / <%= inr(CAREER_TRACKS[1].price) %>, all-inclusive</dd></div>
      <div data-reveal><dt>Format</dt><dd>Live online training, then a supervised internship</dd></div>
      <div data-reveal><dt>Who can apply</dt><dd>BTech, BCA, MCA and similar</dd></div>
    </dl>
  </div>
</section>

<%- include('partials/trust', { stats, credentials }) %>
<%- include('partials/batch-panel', { alt: true }) %>
<%- include('partials/track-story') %>
<% const tools = TECH_STACK; %>
<% if (tools.length) { %>
<div class="ticker ticker-light" aria-label="Tools and technologies taught">
  <div class="ticker-track">
    <% for (let r = 0; r < 2; r++) { %><div class="ticker-group"<% if (r) { %> aria-hidden="true"<% } %>><% tools.forEach(t => { %><span><%= t %></span><i aria-hidden="true">&#10022;</i><% }) %></div><% } %>
  </div>
</div>
<% } %>

<section class="section" aria-labelledby="inc-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What is included</p>
      <h2 id="inc-h" class="h2" data-reveal>Everything you need <em>to finish.</em></h2>
      <p class="section-intro included-note" data-reveal><strong>Projects and internship included.</strong> Your classes, study material, assignments, projects and the internship all come in one programme.</p>
    </div>
    <ul class="values values-3" data-zoom data-reveal-group>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'tag' }) %></span><h3>Study material</h3><p>Notes, slides and reading for every module, yours to keep.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'browser' }) %></span><h3>Live classes</h3><p>Taught live online by an instructor, with time for questions.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'check' }) %></span><h3>Assignments</h3><p>A task after each module, checked by an instructor, so you practise instead of only watching.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'code' }) %></span><h3>Projects</h3><p>Mini projects during training and one capstone you can show and explain in an interview.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'user' }) %></span><h3>Mentor support</h3><p>Doubt sessions and code or work reviews from the instructor team.</p></li>
      <li data-reveal><span class="service-icon"><%- include('partials/icon', { name: 'key' }) %></span><h3>Internship offer</h3><p>Complete the training and assessment, and you are offered a supervised internship on studio or practice work.</p></li>
    </ul>
  </div>
</section>

<section class="section section-alt" id="programs" aria-labelledby="programs-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>Programmes</p>
        <h2 id="programs-h" class="h2" data-reveal>Choose a <em>programme</em></h2>
      </div>
      <p class="section-intro" data-reveal>Pick the role you want to learn, in the 3-Month or the 6-Month Programme. Open a programme for its curriculum, tools and batches. Interested in something close to these? Apply with "Similar role" and name it in your note.</p>
    </div>
    <ul class="role-grid" data-reveal-group data-zoom>
      <% PROGRAMS.forEach((t, i) => { %>
      <li data-reveal id="program-<%= t.slug %>">
        <div class="role-card">
          <span class="service-top"><span class="service-icon"><%- include('partials/icon', { name: t.icon }) %></span><span class="service-num"><%= String(i + 1).padStart(2, '0') %></span></span>
          <h3 class="service-name"><a class="role-link" href="/internship/programs/<%= t.slug %>"><%= t.name %></a></h3>
          <p class="service-blurb"><%= t.summary %></p>
          <ul class="program-meta">
            <li>3 or 6 months</li><li>From <%= inr(offer.fromPrice(CAREER_TRACKS)) %></li>
          </ul>
          <a class="btn btn-primary btn-apply" href="/internship/programs/<%= t.slug %>" aria-label="Apply now: <%= t.name %>">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </li>
      <% }) %>
      <li data-reveal>
        <div class="role-card role-card-similar">
          <span class="service-top"><span class="service-icon"><%- include('partials/icon', { name: 'spark' }) %></span><span class="service-num">+</span></span>
          <h3 class="service-name">And similar roles</h3>
          <p class="service-blurb">Interested in a related field? Apply with "Similar role" and tell us which one in your note.</p>
          <a class="btn btn-primary btn-apply" href="/internship?track=<%= encodeURIComponent(SIMILAR_ROLE) %>#apply" data-dialog="dlg-apply" data-fallback-form="apply" data-prefill-name="track" data-prefill-value="<%= SIMILAR_ROLE %>">Apply now <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </li>
    </ul>
  </div>
</section>

<%- include('partials/compare') %>
<%- include('partials/free-start') %>
<%- include('partials/people', { instructors, testimonials }) %>
<%- include('partials/why-trust', { credentials }) %>
<%- include('partials/samples', { sampleDocs, alt: true }) %>
<%- include('partials/student-work', { projects }) %>
<%- include('partials/gallery', { gallery }) %>

<section class="section section-alt" aria-labelledby="rules-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What you take away</p>
      <h2 id="rules-h" class="h2" data-reveal>Everything you earn <em>on the way.</em></h2>
    </div>
    <div class="rules" data-reveal-group>
      <div class="rules-col rules-yes" data-reveal>
        <h3>You receive</h3>
        <ul>
          <li><%- include('partials/icon', { name: 'check' }) %><span>Study material, live classes and reviewed assignments</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>Projects you can explain in an interview</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>A training certificate when you finish the training</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>An internship offer, and an internship letter that names your role, dates and work</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>A certificate ID that anyone can <a href="/verify">check with us</a></span></li>
        </ul>
      </div>
      <div class="rules-col rules-yes" data-reveal>
        <h3>Easy to verify</h3>
        <ul>
          <li><%- include('partials/icon', { name: 'check' }) %><span>Issued by an MSME-registered company</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>Suitable for college internship requirements, with the dates, hours and work written down</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>A signed letter with contact details, so colleges and employers can confirm it</span></li>
          <li><%- include('partials/icon', { name: 'check' }) %><span>College-specific formats, hours or NOC support on request</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<%- include('partials/fit-check') %>

<section class="section" aria-labelledby="faq-h">
  <div class="wrap faq-wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Questions students ask</p>
      <h2 id="faq-h" class="h2" data-reveal>Questions, <em>answered.</em></h2>
    </div>
    <%- include('partials/faq-accordion', { items: FAQ.find(group => group.id === 'students').items.filter(i => i.top).slice(0, 10), name: 'faq-internship', openFirst: true }) %>
    <h3 class="h3 faq-sub" data-reveal>For parents</h3>
    <%- include('partials/faq-accordion', { items: FAQ.find(group => group.id === 'parents').items, name: 'faq-parents' }) %>
    <p class="faq-more"><a class="text-link" href="/faq#students">All student questions <%- include('partials/icon', { name: 'arrow' }) %></a></p>
  </div>
</section>

<%- include('partials/final-cta', { inPageApply: true }) %>

<section class="section section-alt" id="apply" aria-labelledby="apply-h">
  <div class="wrap split split-form">
    <div>
      <p class="eyebrow" data-reveal>Apply</p>
      <h2 id="apply-h" class="h2" data-reveal>Send your <em>application</em></h2>
      <p class="section-intro" data-reveal>We read every application and reply by phone or email. Projects and the internship are included in the price.<% if (offer.registrationOpen) { %> Registration for the November 2026 batch closes on <%= REGISTRATION.closes %>, with only <%= SEAT_CAP %> seats per batch.<% } %> Read the <a href="/faq#students">student FAQ</a> and the <a href="/internship/overview.pdf">programme overview (PDF)</a> before you apply.</p>
    </div>
    <div class="form-card" data-reveal>
      <%- include('partials/apply-form') %>
    </div>
  </div>
</section>
<%- include('partials/sticky-cta') %>
<%- include('partials/footer') %>
