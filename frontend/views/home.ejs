<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <div class="hero-rings" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-item>Trusted by real estate firms and schools</p>
      <h1 class="hero-title">
        <span class="line"><span>Software and</span></span>
        <span class="line"><span>marketing that grow</span></span>
        <span class="line"><span><em class="hl">your business.</em></span></span>
      </h1>
      <p class="lede" data-hero-item>Custom software, CRM and ERP, AI automation and digital marketing for growing businesses. From our office in Sector 81, Faridabad, for clients across India.</p>
      <div class="hero-actions" data-hero-item>
        <a class="btn btn-primary btn-lg" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Book a free consultation <%- include('partials/icon', { name: 'arrow' }) %></a>
        <a class="btn btn-ghost btn-lg" href="#services">See our services</a>
      </div>
      <p class="hero-note" data-hero-item>A short call to understand your goals. A clear plan agreed before work begins.</p>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="board" data-parallax="0.04">
        <%- include('partials/corners') %>
        <div class="board-bar">
          <span class="board-brand"><%- include('partials/mark', { cls: 'board-mark', decorative: true, uid: 'board' }) %>Goforge / project board</span>
          <span class="board-tag">Illustration</span>
        </div>
        <p class="board-eyebrow">How a project moves</p>
        <p class="board-title">From first call to handover.</p>
        <ol class="board-steps">
          <li class="is-done"><span class="bs-num">01</span><span class="bs-name">Listen<small>What is in the way</small></span><span class="bs-state"><%- include('partials/icon', { name: 'check' }) %></span></li>
          <li class="is-done"><span class="bs-num">02</span><span class="bs-name">Shape<small>A clear plan agreed</small></span><span class="bs-state"><%- include('partials/icon', { name: 'check' }) %></span></li>
          <li class="is-active"><span class="bs-num">03</span><span class="bs-name">Build<small>Progress you can see</small></span><span class="bs-progress"><span></span></span></li>
          <li><span class="bs-num">04</span><span class="bs-name">Hand over<small>A short note on how to run it</small></span><span class="bs-state bs-wait"></span></li>
        </ol>
      </div>
      <div class="chip chip-a" data-parallax="-0.06"><span class="chip-icon"><%- include('partials/icon', { name: 'tag' }) %></span><span>Clear plan,<strong>agreed first</strong></span></div>
      <div class="chip chip-b" data-parallax="0.09"><span class="chip-icon"><%- include('partials/icon', { name: 'user' }) %></span><span>A person<strong>in the loop</strong></span></div>
    </div>
  </div>
</section>

<% if (stats.length) { %><%- include('partials/trust', { stats, credentials }) %><% } else { %><%- include('partials/trust-band', { credentials }) %><% } %>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <% for (let r = 0; r < 2; r++) { %><div class="ticker-group"><% SERVICES.forEach(svc => { %><span><%= svc.name %></span><i>&#10022;</i><% }) %></div><% } %>
  </div>
</div>

<section class="section" id="services" aria-labelledby="services-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>Services</p>
        <h2 id="services-h" class="h2" data-reveal>What we <em>do for you.</em></h2>
      </div>
      <p class="section-intro" data-reveal>Four core services. Pick one, or tell us the challenge and we will recommend the right fit.</p>
    </div>
    <ul class="service-grid" data-reveal-group data-zoom>
      <% SERVICES.forEach((svc, i) => { %>
      <li class="service-card" data-reveal>
        <a href="/services/<%= svc.slug %>" class="service-link" data-dialog="dlg-svc-<%= svc.slug %>">
          <%- include('partials/corners') %>
          <span class="service-top">
            <span class="service-icon"><%- include('partials/icon', { name: svc.icon }) %></span>
            <span class="service-num">0<%= i + 1 %></span>
          </span>
          <h3 class="service-name"><%= svc.name %></h3>
          <p class="service-blurb"><%= s[svc.key] %></p>
          <span class="service-more">Let's explore <%- include('partials/icon', { name: 'upright' }) %></span>
        </a>
      </li>
      <% }) %>
    </ul>
  </div>
</section>


<section class="section section-alt" id="industries" aria-labelledby="ind-h">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>Industries we serve</p>
      <h2 id="ind-h" class="h2" data-reveal>Who we <em>work with.</em></h2>
    </div>
    <ul class="ind-grid" data-reveal-group>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'pin' }) %></span><h3>Real estate</h3><p>Websites, lead capture and a simple CRM, so every property enquiry gets a quick follow-up.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'cap' }) %></span><h3>Schools</h3><p>A clear website, admission enquiries in one place, and timely updates for parents.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'briefcase' }) %></span><h3>Growing businesses</h3><p>Custom tools, CRM and marketing that save time and bring in more customers.</p></li>
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="proc-h">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 id="proc-h" class="h2" data-reveal>Four simple <em>steps.</em></h2>
    </div>
    <ol class="proc4" data-reveal-group>
      <li data-reveal><span class="step-num">1</span><h3>Free consultation</h3><p>A short call to understand your business and goals.</p></li>
      <li data-reveal><span class="step-num">2</span><h3>Clear plan</h3><p>A clear plan agreed before work begins.</p></li>
      <li data-reveal><span class="step-num">3</span><h3>Build and review</h3><p>Regular demos you can see and approve.</p></li>
      <li data-reveal><span class="step-num">4</span><h3>Launch and support</h3><p>Go live with a handover and 30 days of support.</p></li>
    </ol>
  </div>
</section>

<%- include('partials/people', { instructors: [], testimonials: clientTestimonials, tesEyebrow: 'What clients say' }) %>

<section class="section section-alt" aria-labelledby="why-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Why Goforge Digital</p>
      <h2 id="why-h" class="h2" data-reveal>Why clients <em>choose us.</em></h2>
    </div>
    <ul class="values" data-reveal-group>
      <% WHY_SMALL.forEach(item => { %>
      <li data-reveal><h3><%= item.title %></h3><p><%= item.text %></p></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="section about-home" aria-labelledby="about-h">
  <div class="wrap about-home-grid">
    <div class="orbit" aria-hidden="true" data-reveal>
      <span class="orbit-ring r1"></span><span class="orbit-ring r2"></span><span class="orbit-ring r3"></span>
      <span class="orbit-dot d1"></span><span class="orbit-dot d2"></span>
      <div class="orbit-core">
        <%- include('partials/mark', { cls: 'orbit-mark', decorative: true, uid: 'orbit', sizes: '(max-width: 600px) 45vw, 200px', lazy: true }) %>
        <span class="orbit-words">Listen &middot; Shape &middot; Build</span>
      </div>
    </div>
    <div>
      <p class="eyebrow" data-reveal>About us</p>
      <h2 id="about-h" class="h2" data-reveal>A registered team <em>you can meet.</em></h2>
      <p class="section-intro" data-reveal>Goforge Digital is an MSME-registered company led by Rohit Sharma, Founder &amp; Director. When you work with us, you speak with the people doing the work.</p>
      <dl class="about-facts" data-reveal-group>
        <div data-reveal><dt>Who you talk to</dt><dd>Rohit Sharma, Founder &amp; Director</dd></div>
        <div data-reveal><dt>Who we work with</dt><dd>Real estate firms, schools and growing businesses</dd></div>
      </dl>
      <a class="text-link" href="/about" data-reveal>Get to know us <%- include('partials/icon', { name: 'arrow' }) %></a>
    </div>
  </div>
</section>

<section class="students-strip" aria-labelledby="stu-h">
  <div class="wrap">
    <a class="stu-card" href="/internship" data-reveal>
      <span class="audience-k">For students</span>
      <span id="stu-h" class="stu-t">Training and internship programmes</span>
      <span class="stu-d">6 weeks of live training, then a 12-week internship on real projects.</span>
      <span class="stu-go">Explore programmes <%- include('partials/icon', { name: 'arrow' }) %></span>
    </a>
  </div>
</section>

<section class="cta-band" aria-labelledby="cta-h">
  <div class="navy-rings" aria-hidden="true"><span></span><span></span></div>
  <div class="wrap cta-grid">
    <div>
      <p class="eyebrow eyebrow-light" data-reveal>Get started</p>
      <h2 id="cta-h" class="h2 h2-light" data-reveal>Ready to grow <em>your business?</em></h2>
      <p class="navy-text" data-reveal>Tell us your goals. We will suggest the right solution and a clear plan, free of charge.</p>
      <div class="hero-actions" data-reveal>
        <a class="btn btn-gold btn-lg" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Book a free consultation <%- include('partials/icon', { name: 'arrow' }) %></a>
        <a class="text-link text-link-light" href="/contact?service=<%= encodeURIComponent(OFFERS.check.name) %>" data-dialog="dlg-contact" data-fallback-form="contact" data-prefill-name="service" data-prefill-value="<%= OFFERS.check.name %>">Or ask for a free website check</a>
      </div>
    </div>
    <ul class="cta-contacts" data-reveal-group>
      <li data-reveal><a href="<%= telHref(s.phone1) %>"><span class="cc-k">Phone</span><span class="cc-v"><%= s.phone1 %></span><%- include('partials/icon', { name: 'upright' }) %></a></li>
      <li data-reveal><a href="<%= telHref(s.phone2) %>"><span class="cc-k">Phone</span><span class="cc-v"><%= s.phone2 %></span><%- include('partials/icon', { name: 'upright' }) %></a></li>
      <li data-reveal><a href="mailto:<%= s.email %>"><span class="cc-k">Email</span><span class="cc-v break"><%= s.email %></span><%- include('partials/icon', { name: 'upright' }) %></a></li>
    </ul>
  </div>
</section>

<%- include('partials/footer') %>
