<%- include('partials/head') %>
<%- include('partials/header') %>

<%# Home hero: one message for both audiences. Left: who we are + proof. Right: two clear paths (businesses / students).
    Every number comes from Admin (stats, credentials), Settings (Google badge) or CAREER_TRACKS (fees). %>
<% const mo = n => n + ' month' + (n > 1 ? 's' : '');
   const hst = (stats || []).slice(0, 3); %>
<section class="hero hero-photo hb-hero" data-hero aria-labelledby="hb-h1">
  <%# Background photo: Ilya Pavlov on Unsplash (Unsplash License), https://unsplash.com/photos/OqtafYT5kTw. Self-hosted WebP; preloaded in partials/head. %>
  <img class="hero-bg" src="/img/hero/hero-code-1280.webp" srcset="/img/hero/hero-code-768.webp 768w, /img/hero/hero-code-1280.webp 1280w, /img/hero/hero-code-1920.webp 1920w" sizes="100vw" width="1920" height="1282" alt="" fetchpriority="high" decoding="async">
  <div class="wrap hb-grid">
    <div class="hb-copy">
      <p class="eyebrow" data-hero-item>Custom software development company in Faridabad</p>
      <h1 id="hb-h1" class="hero-title hb-title">Industry training + internship, <em>inside a working software company.</em></h1>
      <p class="lede" data-hero-item>Goforge Digital is an MSME-registered software company in Sector 81, Faridabad. We build <a href="/services/custom-software-development">custom software</a>, <a href="/services/website-development">websites</a>, <a href="/services/crm-development">CRM</a> and <a href="/services/erp-development">ERP systems</a> for businesses, and train students on the same kind of real-world projects.</p>
      <ul class="hb-proof" data-hero-item aria-label="Goforge Digital at a glance">
        <% if (s.show_google_badge !== '0') { %><li class="hb-proof-g"><%- include('partials/gr-badge') %></li><% } %>
        <% if (s.show_home_stats !== '0') { hst.forEach(x => { %><li class="hb-stat"><strong><%= x.value %><%= x.suffix || '' %></strong><span><%= x.label %></span></li><% }) } %>
      </ul>
    </div>

    <div class="hb-paths" data-hero-item>
      <section class="hb-path" aria-labelledby="hb-biz">
        <p class="hb-k"><%- include('partials/icon', { name: 'briefcase' }) %>For businesses</p>
        <h2 id="hb-biz" class="hb-h">Software, websites, CRM &amp; ERP built for you.</h2>
        <p class="hb-line">A short call, a clear plan agreed before work begins.</p>
        <a class="btn btn-cta hb-btn" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Book a free consultation <%- include('partials/icon', { name: 'arrow' }) %></a>
        <a class="hb-more" href="#services">See our services</a>
      </section>
      <section class="hb-path" aria-labelledby="hb-stu">
        <p class="hb-k"><%- include('partials/icon', { name: 'cap' }) %>For students</p>
        <h2 id="hb-stu" class="hb-h">Training + internship on real-world projects.</h2>
        <ul class="hb-fees" aria-label="Programmes and fees">
          <% CAREER_TRACKS.forEach(t => { %><li><strong><%= inr(offer.priceOf(t)) %></strong><span><b><%= t.name %></b> &middot; <%= mo(t.trainingMonths) %> training + <%= mo(t.internshipMonths) %> internship</span></li><% }) %>
        </ul>
        <p class="hb-line">All-inclusive fees.<% if (offer.registrationOpen) { %> <%= BATCH_LABEL.replace(/^./, c => c.toUpperCase()) %> starts <%= BATCH_STARTS_FULL %> &middot; registration closes <%= REGISTRATION.closesFull %>.<% } %></p>
        <a class="btn btn-cta hb-btn" href="/internship#apply"><% if (offer.registrationOpen) { %>Apply for <%= BATCH_LABEL.replace(/^January/, 'Jan') %><% } else { %>Explore training + internship<% } %> <%- include('partials/icon', { name: 'arrow' }) %></a>
        <a class="hb-more" href="/internship">Programme details</a>
      </section>
    </div>
  </div>
</section>

<% if (stats.length) { %><%- include('partials/trust', { stats, credentials }) %><% } else { %><%- include('partials/trust-band', { credentials }) %><% } %>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <% for (let r = 0; r < 2; r++) { %><div class="ticker-group"><% SERVICES.forEach(svc => { %><span><%= svc.name %></span><i>&#10022;</i><% }) %></div><% } %>
  </div>
</div>

<section class="section" id="services" aria-labelledby="services-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>Services</p>
        <h2 id="services-h" class="h2" data-reveal>What we <em>do for you.</em></h2>
      </div>
      <p class="section-intro" data-reveal>Four core services for growing businesses. Choose one, or share your goal and we will recommend the right fit.</p>
    </div>
    <ul class="service-grid" data-reveal-group data-zoom>
      <% SERVICES.forEach((svc, i) => { %>
      <li class="service-card" data-reveal>
        <a href="/services/<%= svc.slug %>" class="service-link" data-dialog="dlg-svc-<%= svc.slug %>">
          <%- include('partials/corners') %>
          <span class="service-top">
            <span class="service-icon"><%- include('partials/icon', { name: svc.icon }) %></span>
            <span class="service-num">0<%= i + 1 %></span>
          </span>
          <h3 class="service-name"><%= svc.name %></h3>
          <p class="service-blurb"><%= s[svc.key] %></p>
          <span class="service-more">Explore service <%- include('partials/icon', { name: 'upright' }) %></span>
        </a>
      </li>
      <% }) %>
    </ul>
    <div class="more-services-wrap" data-reveal>
      <p class="mini-h">More software services</p>
      <ul class="svc-related svc-more4">
        <% SERVICE_PAGES.filter(x => !SERVICES.some(c => c.slug === x.slug)).forEach(r => { %><li><a href="/services/<%= r.slug %>"><span class="service-icon"><%- include('partials/icon', { name: r.icon }) %></span><span><%= r.short || r.name %></span><%- include('partials/icon', { name: 'arrow' }) %></a></li><% }) %>
      </ul>
    </div>
  </div>
</section>


<section class="section section-alt" id="industries" aria-labelledby="ind-h">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>Industries we serve</p>
      <h2 id="ind-h" class="h2" data-reveal>Who we <em>build for.</em></h2>
    </div>
    <ul class="ind-grid" data-reveal-group>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'pin' }) %></span><h3>Real estate</h3><p>Websites, lead capture and a simple CRM, so every property enquiry gets a quick follow-up.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'book' }) %></span><h3>Schools</h3><p>A clear website, admission enquiries in one place, and timely updates for parents.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'cap' }) %></span><h3>Colleges</h3><p>Admission enquiry systems, college ERP and websites that make applying simple.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'globe' }) %></span><h3>Universities</h3><p>Student portals, ERP and integrations that bring departments onto one system.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'spark' }) %></span><h3>Startups</h3><p>MVPs, web apps and launch marketing to get your product in front of customers.</p></li>
      <li class="ind-card" data-reveal><%- include('partials/corners') %><span class="service-icon"><%- include('partials/icon', { name: 'briefcase' }) %></span><h3>Growing businesses</h3><p>Custom tools, CRM and marketing that save time and bring in more customers.</p></li>
    </ul>
  </div>
</section>

<section class="section" id="recent-work" aria-labelledby="rw-h">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow" data-reveal>Recent work</p>
        <h2 id="rw-h" class="h2" data-reveal>Websites we have <em>built.</em></h2>
      </div>
      <p class="section-intro" data-reveal>A live site for a real estate client, plus sample school websites, clearly marked as demos. <a href="/work">See all work</a>.</p>
    </div>
    <%- include('partials/showcase', { ids: ['vaishnavi', 'harold', 'mvm', 'saini'], cols: 4 }) %>
  </div>
</section>

<section class="section" aria-labelledby="proc-h">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 id="proc-h" class="h2" data-reveal>Four simple <em>steps.</em></h2>
    </div>
    <ol class="proc4" data-reveal-group>
      <li data-reveal><span class="step-num">1</span><h3>Free consultation</h3><p>A short call to understand your business and goals.</p></li>
      <li data-reveal><span class="step-num">2</span><h3>Clear plan</h3><p>A clear plan agreed before work begins.</p></li>
      <li data-reveal><span class="step-num">3</span><h3>Build and review</h3><p>Regular demos you can see and approve.</p></li>
      <li data-reveal><span class="step-num">4</span><h3>Launch and support</h3><p>Go live with a handover and 30 days of support.</p></li>
    </ol>
  </div>
</section>

<%# Google badge sits in the hero proof row on Home, so the reviews section skips it (one badge per page). %>
<%- include('partials/google-reviews', { kind: 'client', alt: true, showBadge: false }) %>
<%- include('partials/people', { instructors: [], testimonials: clientTestimonials, tesEyebrow: 'What clients say' }) %>

<section class="section section-alt" aria-labelledby="why-h">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Why Goforge Digital</p>
      <h2 id="why-h" class="h2" data-reveal>Why clients <em>choose us.</em></h2>
    </div>
    <ul class="values" data-reveal-group>
      <% WHY_SMALL.forEach(item => { %>
      <li data-reveal><h3><%= item.title %></h3><p><%= item.text %></p></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="section about-home" aria-labelledby="about-h">
  <div class="wrap about-home-grid">
    <div class="orbit" aria-hidden="true" data-reveal>
      <span class="orbit-ring r1"></span><span class="orbit-ring r2"></span><span class="orbit-ring r3"></span>
      <span class="orbit-dot d1"></span><span class="orbit-dot d2"></span>
      <div class="orbit-core">
        <%- include('partials/mark', { cls: 'orbit-mark', decorative: true, uid: 'orbit', sizes: '(max-width: 600px) 45vw, 200px', lazy: true }) %>
        <span class="orbit-words">Listen &middot; Shape &middot; Build</span>
      </div>
    </div>
    <div>
      <p class="eyebrow" data-reveal>About us</p>
      <h2 id="about-h" class="h2" data-reveal>A registered team <em>you can meet.</em></h2>
      <p class="section-intro" data-reveal>Goforge Digital is an MSME-registered company led by Rohit Sharma, Founder &amp; Director. When you work with us, you speak with the people doing the work.</p>
      <dl class="about-facts" data-reveal-group>
        <div data-reveal><dt>Who you talk to</dt><dd>Rohit Sharma, Founder &amp; Director</dd></div>
        <div data-reveal><dt>Who we build for</dt><dd>Real estate, schools, colleges, universities, startups and growing businesses</dd></div>
      </dl>
      <a class="text-link" href="/about" data-reveal>Get to know us <%- include('partials/icon', { name: 'arrow' }) %></a>
    </div>
  </div>
</section>

<section class="students-strip" aria-labelledby="stu-h">
  <div class="wrap">
    <a class="stu-card" href="/internship" data-reveal>
      <span class="audience-k">For students</span>
      <span id="stu-h" class="stu-t">Training + internship: 3 or 6 months</span>
      <span class="stu-d"><%= inr(CAREER_TRACKS[0].price) %> (3 months) or <%= inr(CAREER_TRACKS[1].price) %> (6 months), all-inclusive. Live online training, then an internship on real projects.<% if (s.price_value_line) { %> <span class="price-value"><%= s.price_value_line %></span><% } %><% if (offer.registrationOpen) { %> <strong class="stu-hot"><%= BATCH_SUMMARY %>. Only <%= SEAT_CAP %> seats per schedule.</strong><% } %></span>
      <span class="stu-go">See batches <%- include('partials/icon', { name: 'arrow' }) %></span>
    </a>
  </div>
</section>
<%- include('partials/google-reviews', { kind: 'student', showBadge: false }) %>

<%- include('partials/webinar-card') %>

<section class="cta-band" aria-labelledby="cta-h">
  <div class="navy-rings" aria-hidden="true"><span></span><span></span></div>
  <div class="wrap cta-grid">
    <div>
      <p class="eyebrow eyebrow-light" data-reveal>Get started</p>
      <h2 id="cta-h" class="h2 h2-light" data-reveal>Ready to grow <em>your business?</em></h2>
      <p class="navy-text" data-reveal>Tell us your goals. We will suggest the right solution and a clear plan, free of charge.</p>
      <div class="hero-actions" data-reveal>
        <a class="btn btn-gold btn-lg" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Book a free consultation <%- include('partials/icon', { name: 'arrow' }) %></a>
        <a class="text-link text-link-light" href="/contact?service=<%= encodeURIComponent(OFFERS.check.name) %>" data-dialog="dlg-contact" data-fallback-form="contact" data-prefill-name="service" data-prefill-value="<%= OFFERS.check.name %>">Or ask for a free website check</a>
      </div>
    </div>
    <ul class="cta-contacts" data-reveal-group>
      <li data-reveal><a href="<%= telHref(s.phone1) %>"><span class="cc-k">Phone</span><span class="cc-v"><%= s.phone1 %></span><%- include('partials/icon', { name: 'upright' }) %></a></li>
      <li data-reveal><a href="<%= telHref(s.phone2) %>"><span class="cc-k">Phone</span><span class="cc-v"><%= s.phone2 %></span><%- include('partials/icon', { name: 'upright' }) %></a></li>
      <li data-reveal><a href="mailto:<%= s.email %>"><span class="cc-k">Email</span><span class="cc-v break"><%= s.email %></span><%- include('partials/icon', { name: 'upright' }) %></a></li>
    </ul>
  </div>
</section>

<%- include('partials/footer') %>
