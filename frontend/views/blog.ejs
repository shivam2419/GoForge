<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow" data-hero-item>Blog</p>
    <h1 class="h1 hero-title-sm"><span class="line"><span>Short guides for</span></span> <span class="line"><span><em>students and colleges.</em></span></span></h1>
    <p class="lede" data-hero-item>Practical reading on skills, internships and choosing a programme. Each one takes a few minutes.</p>
  </div>
</section>
<section class="section section-tight" aria-labelledby="posts-h">
  <div class="wrap">
    <h2 id="posts-h" class="visually-hidden">Articles</h2>
    <ul class="blog-grid" data-reveal-group>
      <% POSTS.forEach(p => { %>
      <li class="blog-card" data-reveal>
        <p class="blog-meta"><span><%= p.topic %></span><span><%= p.read %> min read</span></p>
        <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
        <p><%= p.summary %></p>
        <a class="text-link" href="/blog/<%= p.slug %>" aria-label="Read: <%= p.title %>">Read <%- include('partials/icon', { name: 'arrow' }) %></a>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<%- include('partials/footer') %>
