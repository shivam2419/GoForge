<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="wrap narrow">
    <div class="form-success is-static">
      <span class="success-icon"><%- include('partials/icon', { name: 'check' }) %></span>
      <h1 class="h2">Sent</h1>
      <p><%= message %></p>
      <p class="success-wa-note">Send the same text on WhatsApp so it reaches us straight away:</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= whatsappUrl %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'whatsapp' }) %> Open WhatsApp</a>
        <a class="btn btn-ghost" href="/">Back to home</a>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
