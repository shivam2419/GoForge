<%# Closing navy band for training pages. Urgency only from real dates and the real cap. %>
<section class="cta-band cta-band-students" aria-labelledby="fcta-h">
  <div class="navy-rings" aria-hidden="true"><span></span><span></span></div>
  <div class="wrap fcta">
    <p class="eyebrow eyebrow-light" data-reveal><%= offer.registrationOpen ? BATCH_LABEL : 'Next batch: ' + NEXT_AFTER %></p>
    <% const seatsLeftAll = BATCHES.reduce((n, b) => n + SEATS[b.key].left, 0), anyRealSeats = BATCHES.some(b => SEATS[b.key].show); %>
    <h2 id="fcta-h" class="h2 h2-light" data-reveal><%- !offer.registrationOpen ? 'Join the <em>' + NEXT_AFTER + ' batch.</em>' : (anyRealSeats ? (seatsLeftAll ? 'Take one of the <em>' + seatsLeftAll + ' seats left.</em>' : 'Both batches are <em>full.</em>') : 'Take one of the <em>' + SEAT_CAP + ' seats.</em>') %></h2>
    <ul class="fcta-facts" data-reveal>
      <li><span>From</span><strong><%= inr(offer.fromPrice(CAREER_TRACKS)) %></strong></li>
      <% if (offer.registrationOpen && BATCHES.some(b => SEATS[b.key].show)) { BATCHES.forEach(b => { const st = SEATS[b.key]; %><li class="fcta-seat"><span><%= b.name.replace(' batch', '') %> seats</span><strong><% if (!st.full) { %><span class="live-dot" aria-hidden="true"></span><% } %><%= st.full ? 'Full' : st.left + ' of ' + st.cap + ' left' %></strong></li><% }) } else { %><li><span>Seats</span><strong><%= SEAT_CAP %> per batch</strong></li><% } %>
      <li><span><%= offer.registrationOpen ? 'Registration closes' : 'Status' %></span><strong><%= offer.registrationOpen ? REGISTRATION.closesShort : 'Waitlist open' %></strong></li>
      <li><span>Format</span><strong>Live online, recorded</strong></li>
    </ul>
    <div class="hero-actions fcta-actions" data-reveal>
      <a class="btn btn-gold btn-lg" href="#apply"<% if (!locals.inPageApply) { %> data-dialog="dlg-apply" data-fallback-form="apply"<% } %>>Apply now <%- include('icon', { name: 'arrow' }) %></a>
      <a class="btn btn-ghost-light btn-lg" href="/counselling<%= locals.program ? '?program=' + encodeURIComponent(program) : '' %>" data-dialog="dlg-counsel" data-fallback-form="counsel"<% if (locals.program) { %> data-prefill-name="program" data-prefill-value="<%= program %>"<% } %>>Book a free counselling call</a>
    </div>
  </div>
</section>
