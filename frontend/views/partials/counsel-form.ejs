<% const px = locals.px || 'cc'; const progs = PROGRAMS.map(p => p.name); %>
<form class="form" data-form="counsel" method="post" action="/counselling" novalidate data-ajax-form>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="hp" aria-hidden="true"><label for="<%= px %>-website">Leave this empty</label><input id="<%= px %>-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
  <div class="form-alert" role="alert" data-form-alert<% if (!Object.keys(errors).length) { %> hidden<% } %>><%= Object.keys(errors).length ? 'Please check the highlighted fields.' : '' %></div>
  <div class="form-grid">
    <%- include('field', { f: { id: px + '-name', name: 'name', label: 'Your name', required: true, min: 2, max: 80, autocomplete: 'name' } }) %>
    <%- include('field', { f: { id: px + '-phone', name: 'phone', label: 'Phone', type: 'tel', required: true, max: 20, autocomplete: 'tel', inputmode: 'tel' } }) %>
    <%- include('field', { f: { id: px + '-email', name: 'email', label: 'Email', type: 'email', max: 120, autocomplete: 'email' } }) %>
    <%- include('field', { f: { id: px + '-program', name: 'program', label: 'Programme', as: 'select', options: progs, placeholder: 'Not sure yet' } }) %>
    <%- include('field', { f: { id: px + '-time', name: 'time', label: 'Preferred time to call', as: 'select', options: COUNSEL_TIMES, placeholder: 'Any time', wide: true } }) %>
  </div>
  <div class="form-foot">
    <button class="btn btn-primary" type="submit" data-submit>Book my call <%- include('icon', { name: 'arrow' }) %></button>
    <p class="form-note">A free 15-minute call about the programme, batch dates, fees and your college requirements. No payment is taken on the call. <a href="/privacy">Privacy notice</a>.</p>
  </div>
  <%- include('form-success') %>
</form>
