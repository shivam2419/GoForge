<%# Compact seats-left line for strips and bands. Numbers come only from Admin > Settings (seats filled). %>
<% const anyReal = BATCHES.some(b => SEATS[b.key].show); %>
<% if (offer.registrationOpen && anyReal) { %><span class="seat-mini<%= locals.cls ? ' ' + cls : '' %>"><span class="live-dot" aria-hidden="true"></span><% BATCHES.forEach((b, i) => { const st = SEATS[b.key]; %><%= i ? ' · ' : '' %><span class="sm-item"><%= b.name.replace(' batch', '') %> <strong><%= st.full ? 'full' : st.left + ' of ' + st.cap + ' left' %></strong></span><% }) %></span><% } else { %><span class="<%= locals.fallbackCls || '' %>">Only <%= SEAT_CAP %> seats per batch</span><% } %>
