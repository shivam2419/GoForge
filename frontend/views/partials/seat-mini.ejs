<%# Compact seats-left text for strips and bands. Numbers come only from Admin > Settings (seats filled). %>
<% const anyReal = BATCHES.some(b => SEATS[b.key].show); %>
<% if (offer.registrationOpen && anyReal) { %><span class="seat-mini<%= locals.cls ? ' ' + cls : '' %>">Seats left: <% BATCHES.forEach((b, i) => { const st = SEATS[b.key]; %><%= i ? ' · ' : '' %><%= b.name.replace(' batch', '').toLowerCase() %> <strong><%= st.full ? 'full' : st.left %></strong><% }) %></span><% } else { %><span class="<%= locals.fallbackCls || '' %>">Only <%= SEAT_CAP %> seats per batch</span><% } %>
