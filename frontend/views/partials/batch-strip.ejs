<%# One-line summary of the January 2027 batch, for heroes. Hides batch dates after registration closes. %>
<% if (offer.registrationOpen) { %>
<p class="next-batch" data-hero-item>
  <strong><%= BATCH_LABEL %></strong>
  <span>Starts <%= BATCH_STARTS_FULL %></span>
  <span>Choose weekday or weekend schedule</span>
  <%- include('seat-mini', { fallbackCls: 'nb-hot' }) %>
  <span class="nb-hot">Registration closes <%= REGISTRATION.closesFull %></span>
  <a href="<%= locals.anchor || '/internship#batch' %>">Schedule &amp; timings <%- include('icon', { name: 'arrow' }) %></a>
</p>
<% } else { %>
<p class="next-batch" data-hero-item><strong>Next batch</strong><span>Dates shared on your free counselling call</span><span class="nb-hot">Only <%= SEAT_CAP %> seats per schedule</span></p>
<% } %>
