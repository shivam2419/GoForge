<% const st = locals.stats || [], cr = locals.credentials || []; %>
<% if (st.length || cr.length) { %>
<section class="section section-tight trust" aria-labelledby="trust-h">
  <div class="wrap">
    <h2 id="trust-h" class="visually-hidden">Goforge Digital in numbers</h2>
    <% if (st.length) { %>
    <dl class="kpi-pills trust-stats" data-reveal-group>
      <% st.forEach(x => { %>
      <div data-reveal><dt><span data-count="<%= x.value %>"><%= x.value %></span><%= x.suffix || '' %></dt><dd><%= x.label %></dd></div>
      <% }) %>
    </dl>
    <% const notes = st.filter(x => x.note); if (notes.length) { %>
    <p class="trust-notes"><% notes.forEach((x, i) => { %><span><strong><%= x.label %>:</strong> <%= x.note %></span><% }) %></p>
    <% } %>
    <% } %>
    <% if (cr.length) { %>
    <ul class="badge-row" data-reveal-group>
      <% cr.forEach(c => { %>
      <li class="badge-card" data-reveal>
        <% if (c.image_url) { %><img src="<%= c.image_url %>" alt="<%= c.title %> certificate" loading="lazy" width="64" height="64"><% } else { %><span class="service-icon"><%- include('icon', { name: 'check' }) %></span><% } %>
        <span class="badge-text">
          <strong><%= c.title %></strong>
          <% if (c.issuer) { %><span><%= c.issuer %></span><% } %>
          <% if (c.number) { %><span class="badge-num">No. <%= c.number %></span><% } %>
          <% if (c.link_url) { %><a href="<%= c.link_url %>" target="_blank" rel="noopener">Verify <%- include('icon', { name: 'upright' }) %></a><% } %>
        </span>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</section>
<% } %>
