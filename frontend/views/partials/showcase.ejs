<%
// Real client site, clearly labelled demo school websites and a web app. Static on purpose: not admin-managed.
// Locals: only ('client' | 'demo' | 'app'), ids (array of keys, in order), cols (3 or 4).
const SHOWCASE = [
  { id: 'vaishnavi', kind: 'client', name: 'Vaishnavi Associates', url: 'https://vaishnaviassociates.com/', img: '/img/work/vaishnavi-associates.webp', caseStudy: '/work/vaishnavi-associates',
    text: 'Live website for a real estate client, with properties, services, testimonials and a contact enquiry.' },
  { id: 'harold', kind: 'demo', name: 'Harold Public Senior Secondary School', url: 'https://harold-demo.rohitsharma46100.workers.dev/', img: '/img/work/harold-school-demo.webp',
    text: 'Sample school website with admission enquiries, academics, facilities, careers and a Hindi option.' },
  { id: 'mvm', kind: 'demo', name: 'M.V.M. Sr. Sec. School (Modern Vidya Mandir)', url: 'https://mvm-school-demo.netlify.app/', img: '/img/work/mvm-school-demo.webp',
    text: 'Sample school website with an admissions notice, gallery, news and a parent portal link.' },
  { id: 'saini', kind: 'demo', name: 'Saini Public School', url: 'https://sainischool.framer.website/', img: '/img/work/saini-school-demo.webp',
    text: 'Sample school website covering the campus, school life and admission enquiries.' },
  { id: 'aryabhatta', kind: 'demo', name: 'Aryabhatta Public School', url: 'https://school-project-upz6.onrender.com/', img: '/img/work/aryabhatta-school-demo.webp',
    text: 'Sample school website project with admissions, fee structure, bus routes, a gallery, mandatory disclosure and online registration.' },
  { id: 'scrapbridge', kind: 'app', name: 'ScrapBridge', url: 'https://scrapbridge.vercel.app/', img: '/img/work/scrapbridge.webp',
    text: 'Web app for responsible waste disposal: find recycling facilities, book scrap pickup, see scrap prices and classify waste from a photo.' }
];
const TAGS = { client: 'Live client site', demo: 'Demo website', app: 'Web app' };
const LINKS = { client: 'Visit live site', demo: 'View demo', app: 'Open web app' };
let items = SHOWCASE.filter(x => !locals.only || x.kind === locals.only);
if (locals.ids) items = locals.ids.map(id => SHOWCASE.find(x => x.id === id)).filter(Boolean);
const cols = locals.cols || (items.length % 3 === 0 ? 3 : 4);
%>
<ul class="work-grid showcase-grid showcase-cols-<%= cols %>" data-reveal-group>
  <% items.forEach(w => { %>
  <li class="work-card showcase-card" data-reveal>
    <img src="<%= w.img %>" alt="Home page of the <%= w.name %> <%= w.kind === 'demo' ? 'sample website' : (w.kind === 'app' ? 'web app' : 'website') %>" loading="lazy" width="800" height="500">
    <div class="work-body">
      <p class="work-tag work-tag-<%= w.kind %>"><%= TAGS[w.kind] %></p>
      <h3><%= w.name %></h3>
      <p><%= w.text %></p>
      <p class="work-actions">
        <% if (w.caseStudy) { %><a class="text-link work-visit" href="<%= w.caseStudy %>">Read the case study <%- include('icon', { name: 'arrow' }) %></a><% } %>
        <a class="text-link work-visit" href="<%= w.url %>" target="_blank" rel="noopener"><%= LINKS[w.kind] %> <%- include('icon', { name: 'upright' }) %><span class="visually-hidden"> (opens in a new tab)</span></a>
      </p>
    </div>
  </li>
  <% }) %>
</ul>
