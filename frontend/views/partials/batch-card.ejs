<%# Compact batch card. b = BATCHES[i], st = SEATS[b.key] (the admin's real number; nothing is auto-counted).
    The server renders the final state; site.js only animates the bar and number once when the card scrolls into view. %>
<article class="bc3<%= st.full ? ' is-full' : '' %>" aria-labelledby="batch-<%= b.key %>-h" data-seatcard>
  <div class="bc3-top">
    <span class="bc3-status">
      <% if (st.full) { %><span class="bc3-full">Batch full</span><% } else if (offer.registrationOpen) { %><span class="live-dot" aria-hidden="true"></span>Enrolling now<% } %>
      <% if (st.hot) { %><span class="bc3-tag">Filling fast</span><% } %>
    </span>
    <span class="bc3-left"><%= st.full ? '0 seats left' : (st.show ? st.left + ' seats left' : 'Only ' + st.cap + ' seats') %></span>
  </div>
  <h3 id="batch-<%= b.key %>-h" class="bc3-name"><%= b.name %></h3>
  <p class="bc3-when"><%= b.when %></p>
  <% if (st.show) { %>
  <div class="bc3-progress">
    <svg class="bc3-bar" viewBox="0 0 100 4" preserveAspectRatio="none" role="img" aria-label="<%= st.filled %> of <%= st.cap %> seats filled"><rect class="bc3-bg" width="100" height="4" rx="2"/><rect class="bc3-fill" width="<%= st.pct %>" height="4" rx="2"/></svg>
    <p class="bc3-cap" aria-hidden="true"><span data-countup="<%= st.filled %>"><%= st.filled %></span> of <%= st.cap %> filled</p>
  </div>
  <% } %>
  <p class="bc3-meta">Starts <%= b.startsShort %> &middot; Live online, recorded</p>
  <p class="bc3-note"><%= st.full ? 'This batch is full. Join the waitlist or the ' + NEXT_AFTER + ' batch.' : b.note %></p>
  <div class="bc3-ctas">
    <% if (st.full) { %>
    <a class="btn btn-primary btn-sm" href="/counselling" data-dialog="dlg-counsel" data-fallback-form="counsel" data-prefill-name="interest" data-prefill-value="Joining the <%= NEXT_AFTER %> batch">Join the waitlist</a>
    <% } else { %>
    <a class="btn btn-primary btn-sm" href="/internship#apply" data-dialog="dlg-apply" data-fallback-form="apply" aria-label="Reserve your seat in the <%= b.name.toLowerCase() %>">Reserve your seat</a>
    <a class="bc3-link" href="/counselling" data-dialog="dlg-counsel" data-fallback-form="counsel" data-prefill-name="batch" data-prefill-value="<%= BATCH_PREFS[i] %>" aria-label="Book a free call about the <%= b.name.toLowerCase() %>">Book a free call <%- include('icon', { name: 'arrow' }) %></a>
    <% } %>
  </div>
</article>
