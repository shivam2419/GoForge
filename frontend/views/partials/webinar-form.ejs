<%# Short webinar sign-up: name, phone, optional email. Posts to /counselling with the webinar option preselected. %>
<% const px = locals.px || 'wf'; %>
<form class="form wb-form" data-form="webinar" method="post" action="/counselling" novalidate data-ajax-form>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="interest" value="<%= WEBINAR.interest %>">
  <input type="hidden" name="from" value="webinar">
  <div class="hp" aria-hidden="true"><label for="<%= px %>-website">Leave this empty</label><input id="<%= px %>-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
  <div class="form-alert" role="alert" data-form-alert<% if (!Object.keys(errors).length) { %> hidden<% } %>><%= Object.keys(errors).length ? 'Please check the highlighted fields.' : '' %></div>
  <div class="form-grid wb-grid">
    <%- include('field', { f: { id: px + '-name', name: 'name', label: 'Your name', required: true, min: 2, max: 80, autocomplete: 'name', wide: true } }) %>
    <%- include('field', { f: { id: px + '-phone', name: 'phone', label: 'Phone', type: 'tel', required: true, max: 20, autocomplete: 'tel', inputmode: 'tel' } }) %>
    <%- include('field', { f: { id: px + '-email', name: 'email', label: 'Email', type: 'email', max: 120, autocomplete: 'email' } }) %>
  </div>
  <div class="form-foot">
    <button class="btn btn-primary wb-submit" type="submit" data-submit>Save my free seat <%- include('icon', { name: 'arrow' }) %></button>
    <p class="form-note">You get the Google Meet link and a calendar invite on the next screen. Free, no payment. <a href="/privacy">Privacy notice</a>.</p>
  </div>
  <%- include('form-success') %>
</form>
