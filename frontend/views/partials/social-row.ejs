<ul class="footer-social<%= locals.dark ? ' social-dark' : '' %>">
  <li><a href="mailto:<%= s.email %>" aria-label="Email us" title="Email us"><%- include('icon', { name: 'mail' }) %></a></li>
  <% if (s.linkedin_company) { %><li><a href="<%= s.linkedin_company %>" target="_blank" rel="noopener" aria-label="Goforge Digital on LinkedIn" title="LinkedIn"><%- include('icon', { name: 'linkedin' }) %></a></li><% } %>
  <li><a href="<%= BRAND.instagram %>" target="_blank" rel="noopener" aria-label="Goforge Digital on Instagram" title="Instagram"><%- include('icon', { name: 'instagram' }) %></a></li>
</ul>
