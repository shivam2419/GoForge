<div class="sticky-cta" role="region" aria-label="Quick actions">
  <p class="sticky-note"><% if (offer.registrationOpen) { %><strong>Nov batch</strong> &middot; only <%= SEAT_CAP %> seats per batch &middot; closes <%= REGISTRATION.closesShort.replace(/^\w+ /, '') %><% } else { %><strong><%= NEXT_AFTER %> batch</strong> &middot; only <%= SEAT_CAP %> seats per batch<% } %></p>
  <% if (locals.track) { %><a class="btn btn-primary btn-sm" href="#apply">Apply now</a><% } else { %><a class="btn btn-primary btn-sm" href="#apply" data-dialog="dlg-apply" data-fallback-form="apply">Apply now</a><% } %>
  <a class="btn btn-ghost btn-sm" href="/counselling<%= locals.track ? '?program=' + encodeURIComponent(track) : '' %>" data-dialog="dlg-counsel" data-fallback-form="counsel"<% if (locals.track) { %> data-prefill-name="program" data-prefill-value="<%= track %>"<% } %>>Book a free call</a>
</div>
