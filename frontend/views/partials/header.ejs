<body class="<%= locals.bodyClass || '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<% const careers = [['/internship','Internship'],['/schools','Schools'],['/colleges','Colleges']];
   const nav = [['/services','Services', SERVICE_PAGES.map(x => ['/services/' + x.slug, x.name])],['/work','Work'],['/about','About'],[null,'Careers', careers],['/contact','Contact']];
   const isCur = href => href && (path === href || path.startsWith(href + '/')); %>
<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="Goforge Digital home">
      <%- include('mark', { cls: 'brand-mark', decorative: true, uid: 'h' }) %>
      <span class="brand-text"><span class="wordmark">Goforge Digital</span><span class="brand-tag"><%= BRAND.tagline %></span></span>
    </a>
    <nav class="nav-desktop" aria-label="Main">
      <ul>
        <li><a href="/"<% if (path === '/') { %> aria-current="page"<% } %>>Home</a></li>
        <% nav.forEach(([href, label, sub]) => { const cur = isCur(href) || (sub || []).some(([h]) => isCur(h)); %>
        <% if (sub) { %>
        <li class="nav-drop">
          <% if (href) { %><a href="<%= href %>"<% if (cur) { %> aria-current="page"<% } %>><%= label %></a><% } else { %><a href="<%= sub[0][0] %>" aria-haspopup="true"<% if (cur) { %> aria-current="page"<% } %> data-nav-group><%= label %></a><% } %>
          <ul>
            <% sub.forEach(([h, l]) => { %><li><a href="<%= h %>"><%= l %></a></li><% }) %>
          </ul>
        </li>
        <% } else { %>
        <li><a href="<%= href %>"<% if (cur) { %> aria-current="page"<% } %>><%= label %></a></li>
        <% } %>
        <% }) %>
      </ul>
    </nav>
    <a class="btn btn-primary btn-sm header-cta" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Let's talk <%- include('icon', { name: 'upright' }) %></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-label">Menu</span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-menu>
    <nav class="wrap" aria-label="Mobile">
      <ul>
        <li><a href="/"<% if (path === '/') { %> aria-current="page"<% } %>><span class="mm-num">00</span>Home</a></li>
        <% nav.forEach(([href, label, sub], i) => { const cur = path === href; %>
        <li><% if (href) { %><a href="<%= href %>"<% if (cur) { %> aria-current="page"<% } %>><span class="mm-num">0<%= i + 1 %></span><%= label %></a><% } else { %><span class="mm-group"><span class="mm-num">0<%= i + 1 %></span><%= label %></span><% } %>
          <% if (sub && !href) { %><ul class="mm-sub"><% sub.forEach(([h, l]) => { %><li><a href="<%= h %>"<% if (path === h) { %> aria-current="page"<% } %>><%= l %></a></li><% }) %></ul><% } %>
        </li>
        <% }) %>
      </ul>
      <div class="mobile-menu-foot">
        <a class="btn btn-primary" href="/contact" data-dialog="dlg-contact" data-fallback-form="contact">Talk about a project</a>
      </div>
    </nav>
  </div>
</header>
<main id="main" class="page" tabindex="-1">
