<%- include('top') %>
<div class="admin-head">
  <h1 class="admin-title"><%= cfg.title %></h1>
  <p class="admin-sub"><%= total %> <%= total === 1 ? 'item' : 'items' %><%= status ? ' marked ' + status : '' %><%= q ? ' matching “' + q + '”' : '' %></p>
</div>
<% if (flash) { %><div class="flash" role="status"><%= flash %></div><% } %>
<form class="filters" method="get" action="/admin/<%= slug %>" role="search">
  <div class="field field-search">
    <label for="q">Search</label>
    <input id="q" name="q" type="search" value="<%= q %>" placeholder="<%= slug === 'contacts' ? 'Name, business, phone, message' : 'Name, college, role, number' %>">
  </div>
  <div class="field">
    <label for="status">Status</label>
    <div class="select-wrap">
    <select id="status" name="status">
      <option value="">All (<%= counts.New + counts.Contacted + counts.Closed %>)</option>
      <% STATUSES.forEach(st => { %><option value="<%= st %>"<% if (status === st) { %> selected<% } %>><%= st %> (<%= counts[st] %>)</option><% }) %>
    </select>
    </div>
  </div>
  <div class="filter-actions">
    <button class="btn btn-primary" type="submit">Apply</button>
    <% if (q || status) { %><a class="btn btn-ghost" href="/admin/<%= slug %>">Clear</a><% } %>
  </div>
</form>
<div class="status-tabs" role="list">
  <a role="listitem" href="/admin/<%= slug %>"<% if (!status) { %> aria-current="true"<% } %>>All</a>
  <% STATUSES.forEach(st => { %><a role="listitem" href="/admin/<%= slug %>?status=<%= st %>"<% if (status === st) { %> aria-current="true"<% } %>><%= st %> <span><%= counts[st] %></span></a><% }) %>
</div>
<% if (!rows.length) { %>
  <div class="empty"><p><%= (q || status) ? 'Nothing matches this filter.' : (slug === 'contacts' ? 'No enquiries yet. Messages from the contact form will appear here.' : 'No applications yet. Applications from the internship page will appear here.') %></p></div>
<% } else { %>
<ul class="items">
  <% rows.forEach(r => { %>
  <li class="item status-<%= r.status.toLowerCase() %>" id="item-<%= r.id %>">
    <div class="item-head">
      <div>
        <h2 class="item-name"><%= slug === 'contacts' ? r.name : r.full_name %></h2>
        <p class="item-meta">
          <% if (slug === 'contacts') { %><%= r.business || 'No business name given' %><% } else { %><%= r.college %> &middot; <%= r.course_year %><% } %>
        </p>
      </div>
      <span class="pill pill-<%= r.status.toLowerCase() %>"><%= r.status %></span>
    </div>
    <dl class="item-grid">
      <% if (slug === 'contacts') { %>
        <div><dt>Phone</dt><dd><a href="<%= telHref(r.phone) %>"><%= r.phone %></a> &middot; <a href="<%= waUrl(r.phone) %>" target="_blank" rel="noopener">WhatsApp</a></dd></div>
        <div><dt>Service</dt><dd><%= r.service || 'Not chosen' %></dd></div>
      <% } else { %>
        <div><dt>WhatsApp</dt><dd><a href="<%= waUrl(r.whatsapp) %>" target="_blank" rel="noopener"><%= r.whatsapp %></a> &middot; <a href="<%= telHref(r.whatsapp) %>">Call</a></dd></div>
        <div><dt>Programme</dt><dd><%= r.track %></dd></div>
        <% if (r.email) { %><div><dt>Email</dt><dd><a href="mailto:<%= r.email %>"><%= r.email %></a></dd></div><% } %>
        <% if (r.city) { %><div><dt>City</dt><dd><%= r.city %></dd></div><% } %>
        <% if (r.mode) { %><div><dt>Mode</dt><dd><%= r.mode %></dd></div><% } %>
        <% if (r.source) { %><div><dt>Heard via</dt><dd><%= r.source %></dd></div><% } %>
      <% } %>
      <div><dt>Received</dt><dd><time datetime="<%= r.created_at %>"><%= fmtTime(r.created_at) %></time></dd></div>
      <% if (r.updated_at) { %><div><dt>Status changed</dt><dd><time datetime="<%= r.updated_at %>"><%= fmtTime(r.updated_at) %></time></dd></div><% } %>
    </dl>
    <% const body = slug === 'contacts' ? r.message : r.note; %>
    <% if (body) { %><p class="item-body"><%= body %></p><% } %>
    <form class="status-form" method="post" action="/admin/<%= slug %>/<%= r.id %>/status">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="q" value="<%= q %>">
      <input type="hidden" name="f" value="<%= status %>">
      <input type="hidden" name="page" value="<%= page %>">
      <label for="st-<%= r.id %>">Status</label>
      <div class="select-wrap">
      <select id="st-<%= r.id %>" name="status" data-autosubmit>
        <% STATUSES.forEach(st => { %><option value="<%= st %>"<% if (r.status === st) { %> selected<% } %>><%= st %></option><% }) %>
      </select>
      </div>
      <button class="btn btn-ghost btn-sm" type="submit" data-autosubmit-btn>Save</button>
    </form>
  </li>
  <% }) %>
</ul>
<% if (pages > 1) { %>
<nav class="pager" aria-label="Pages">
  <% const base = new URLSearchParams(); if (q) base.set('q', q); if (status) base.set('status', status); %>
  <% if (page > 1) { base.set('page', page - 1); %><a class="btn btn-ghost btn-sm" href="?<%= base %>">Newer</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { base.set('page', page + 1); %><a class="btn btn-ghost btn-sm" href="?<%= base %>">Older</a><% } %>
</nav>
<% } %>
<% } %>
<%- include('bottom') %>
