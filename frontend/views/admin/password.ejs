<%- include('top') %>
<div class="admin-head">
  <h1 class="admin-title">Change password</h1>
  <p class="admin-sub">Signed in as <%= admin.email %>. Use at least 12 characters. Changing it signs out every other session.</p>
</div>
<% if (flash) { %><div class="flash" role="status"><%= flash %></div><% } %>
<form method="post" action="/admin/password" class="form panel narrow-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% [['current','Current password','current-password'],['new_password','New password','new-password'],['confirm','Repeat new password','new-password']].forEach(([n, l, ac]) => { %>
  <div class="field<%= errors[n] ? ' has-error' : '' %>">
    <label for="p-<%= n %>"><%= l %></label>
    <input id="p-<%= n %>" name="<%= n %>" type="password" autocomplete="<%= ac %>" required maxlength="200" aria-describedby="p-<%= n %>-err"<% if (errors[n]) { %> aria-invalid="true"<% } %>>
    <p class="field-error" id="p-<%= n %>-err"><%= errors[n] || '' %></p>
  </div>
  <% }) %>
  <button class="btn btn-primary" type="submit">Change password</button>
</form>
<%- include('bottom') %>
