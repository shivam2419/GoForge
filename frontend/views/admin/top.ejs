<%- include('../partials/head', { adminCss: true }) %>
<body class="admin">
<a class="skip-link" href="#main">Skip to content</a>
<header class="admin-header">
  <div class="admin-wrap admin-header-row">
    <a class="brand" href="/admin" aria-label="Admin home">
      <%- include('../partials/mark', { cls: 'brand-mark', decorative: true, uid: 'ah' }) %>
      <span class="wordmark">Goforge Digital</span><span class="admin-badge">Admin</span>
    </a>
    <nav class="admin-nav" aria-label="Admin">
      <a href="/admin/contacts"<% if (path.startsWith('/admin/contacts')) { %> aria-current="page"<% } %>>Enquiries<% if (newCounts.contacts) { %> <span class="count"><%= newCounts.contacts %></span><% } %></a>
      <a href="/admin/colleges"<% if (path.startsWith('/admin/colleges')) { %> aria-current="page"<% } %>>Colleges<% if (newCounts.colleges) { %> <span class="count"><%= newCounts.colleges %></span><% } %></a>
      <a href="/admin/schools"<% if (path.startsWith('/admin/schools')) { %> aria-current="page"<% } %>>Schools<% if (newCounts.schools) { %> <span class="count"><%= newCounts.schools %></span><% } %></a>
      <a href="/admin/applications"<% if (path.startsWith('/admin/applications')) { %> aria-current="page"<% } %>>Internship<% if (newCounts.applications) { %> <span class="count"><%= newCounts.applications %></span><% } %></a>
      <a href="/admin/programs"<% if (path.startsWith('/admin/programs')) { %> aria-current="page"<% } %>>Programmes</a>
      <a href="/admin/instructors"<% if (path.startsWith('/admin/instructors')) { %> aria-current="page"<% } %>>Instructors</a>
      <a href="/admin/stats"<% if (path.startsWith('/admin/stats')) { %> aria-current="page"<% } %>>Stats</a>
      <a href="/admin/testimonials"<% if (path.startsWith('/admin/testimonials')) { %> aria-current="page"<% } %>>Testimonials</a>
      <a href="/admin/credentials"<% if (path.startsWith('/admin/credentials')) { %> aria-current="page"<% } %>>Badges</a>
      <a href="/admin/settings"<% if (path === '/admin/settings') { %> aria-current="page"<% } %>>Settings</a>
      <a href="/admin/password"<% if (path === '/admin/password') { %> aria-current="page"<% } %>>Password</a>
      <a href="/" target="_blank" rel="noopener">View site</a>
      <form method="post" action="/admin/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="link-btn">Sign out</button>
      </form>
    </nav>
  </div>
</header>
<main id="main" class="admin-main page" tabindex="-1">
<div class="admin-wrap">
